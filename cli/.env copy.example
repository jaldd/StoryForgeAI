# ---- LLM（火山方舟 OpenAI 兼容 coding 网关）----
ARK_API_KEY=你的火山密钥
# 模型（不设则默认 glm-5.2；推理模型，短输出 max_tokens 需 ≥1024）
CLAUDE_MODEL=glm-5.2

# ---- LLM 来源可换（0.7；全不设 = 现状，回落链见各行注释）----
# 主配置（审稿/摘要/评分等非生成调用；也是未配 WRITER_* 时写作侧的回落来源）
# LLM_BASE_URL=           # 未设 -> 火山 https://ark.cn-beijing.volces.com/api/coding/v3
# LLM_API_KEY=            # 未设 -> ARK_API_KEY
# LLM_MODEL=              # 未设 -> CLAUDE_MODEL -> glm-5.2
#
# 写作侧独立（writer/polisher/局部精修；空 = 回落主配置对应解析值，三者各自独立回落）
# WRITER_BASE_URL=
# WRITER_API_KEY=
# WRITER_MODEL=
#
# 换商三件套示例（端点 + key + 模型名按实际填写）：
#   Kimi（Moonshot）：
#     LLM_BASE_URL=https://api.moonshot.cn/v1
#     LLM_API_KEY=你的Moonshot密钥
#     LLM_MODEL=按实际名称填写（如 kimi-k3）
#     注：kimi-k3 等思考模型只允许 temperature=1，客户端遇 400 会自动锁定，
#     各角色调用点的 0.2/0.6/0.8 无需改动
#   SenseNova（商汤）：
#     LLM_BASE_URL=https://api.sensenova.cn/compatible-mode/v2
#     LLM_API_KEY=你的SenseNova密钥
#     LLM_MODEL=按实际名称填写
#
# ---- Embedding（向量库；默认火山方舟，可切 OpenAI 兼容源如 SenseNova Kimi）----
# 默认不配即火山（doubao-embedding-vision，与 ARK_API_KEY 共用）。
# 切到 SenseNova/Kimi 的 embedding 时填以下四行（EMBED_API_KEY 可 = LLM_API_KEY）：
#   EMBED_BASE_URL=https://token.sensenova.cn/v1/embeddings   # 完整 /embeddings 端点
#   EMBED_MODEL=你用的 embedding 模型名（如 kimi-embedding）
#   EMBED_API_KEY=你的SenseNova密钥                          # 未设则回落 ARK_API_KEY
#   EMBED_PROVIDER=openai                                    # openai=OpenAI兼容；volcano=火山；空=按 URL 推断
# 注：provider 留空时会按 embed_url 是否含 volces.com 自动推断（含=火山，否则=openai）。
# 审稿留火山、写作单独换商：改用 WRITER_* 三行（用法同上），主配置不动。
#
# 生成类温度覆盖（写作侧整体；未设 = 调用点默认 0.8/0.6，零漂移）
# NOVEL_TEMPERATURE=0.7
#
# 单代理温度（0.9）：各自独立，优先级高于 NOVEL_TEMPERATURE；未设回落写作侧配置再回落默认
#   writer 默认 0.8 / polisher（含局部精修）默认 0.6 / reviewer 默认 0.2
# NOVEL_WRITER_TEMPERATURE=0.9
# NOVEL_POLISHER_TEMPERATURE=0.5
# NOVEL_REVIEWER_TEMPERATURE=0.3
#
# 辅助调用温度（0.9）：各角色独立，未设 = 括号内默认；fixer 属写作侧，也吃 NOVEL_TEMPERATURE 兜底
# NOVEL_ROUTER_TEMPERATURE=0.1       # 样文路由（0.2）
# NOVEL_FIXER_TEMPERATURE=0.4        # 修复定点/整文（0.5）
# NOVEL_JUDGE_TEMPERATURE=0.2        # 评委 evaluate / 对比 is_better（0.2）
# NOVEL_SUMMARIZER_TEMPERATURE=0.35  # 剧情摘要 / 长期记忆摘要（0.3）
#
# 注：kimi-k3 类模型只允许 temperature=1，客户端遇 400 会自动锁定（锁定后
#     优先于一切配置），以上各键只在模型接受任意温度时生效。
#
# 思考模型推理深度（GLM-5.3 专属 low；max 深/high 中/low 浅；未设 = 不发送、走模型默认）
# 生成调用浅思考实测省约 18 倍思考 token；审稿浅思考意见会变泛，深浅由你按效果取舍
# NOVEL_REASONING_EFFORT=low
# 生成类调用（writer/polisher）专属深度：未设继承 NOVEL_REASONING_EFFORT
# 「审稿深、写作浅」：只设这一行为 low，上面不设
# NOVEL_WRITER_REASONING_EFFORT=low
#
# chat 请求体透传（合法 JSON 对象；与内建参数同名时此值赢，兼作 max_tokens 逃生门）
# NOVEL_LLM_EXTRA={"max_tokens": 8192}
# Kimi-K3 推理调档示例（仅 Kimi-K3 有效；其他模型勿用）：
# NOVEL_LLM_EXTRA={"reasoning_effort": "high"}


# ---- 小说（仓库外，不硬编码）----
# 小说显示名：用于 prompt（如 "我的小说"）。不设默认"本小说"。
NOVEL_NAME=本小说
# 小说内容根目录：含设定(.md)/文风基准/正文。必须在仓库外。
NOVEL_DIR=/path/to/your/novel
# 小说内相对路径（可选，按需改）：
# NOVEL_CHAPTER_SUBDIR=正文/AI生成
# NOVEL_EXEMPLAR=文风基准/1.txt
# 样文标签（exemplar-routing）：每行 "- 文件名: 一行场景描述"，写作前按本章任务选 3~5 篇注入；
# 存在且路由成功只注入选中样文，失败回落全量。留空=禁用路由（每章全量注入）。
# 注意：自定义文件名时请放在文风基准目录外，否则会被当样文注入。
# NOVEL_EXEMPLAR_TAGS=文风基准/样文标签.md
# NOVEL_INSTRUCTION=写作指令.md
# 写作铁律（0.2 外置）：注入 writer/polisher/reviewer 的硬性约束全文。
# NOVEL_RULES=写作铁律.md

# ---- 质量门禁（1.1；相对 novel_dir 的路径）----
# 质量规则 JSON：checker 五项机械检查 / 门禁 eval_gate / AI 味 blacklist 与 ai_score 锚点。
# 默认 质量规则.json；留空 = 禁用。文件不存在 = checker 与门禁不启用（eval 命令照常，仅少 AI 味组件）。
# 字段模板见 specs/quality-gate/design.md §2。
# NOVEL_QUALITY_RULES=质量规则.json
#
# 人工正文目录：AI 味基准语料之二（与文风基准目录合并统计；只读不写）。
# 默认 正文/新；留空 = 不用人工语料（AI 味词频组件可能降级）。
# NOVEL_HUMAN_TEXT=正文/新

# ---- 文风闭环（1.5/1.6；滚动注入 + 去AI重写）----
# 1.5 滚动注入：写作前取人工正文目录（NOVEL_HUMAN_TEXT 同一目录）按文件名序
# 的尾部 N 章注入 writer prompt（学笔性，防文风漂移；只进 writer，不进润色/审稿）。
# 每章只注入前 SLICE_CHARS 字（开篇最见笔性）。目录不存在/为空 -> 自动回落不注入。
# NOVEL_STYLE_RECENT_N=3          # 尾部 N 章；默认 3；0 = 禁用注入
# NOVEL_STYLE_SLICE_CHARS=1000    # 每章截前 N 字；默认 1000；0 = 不截断
#
# 1.6 去AI重写（de-AI pass）：一章流水线完成后 AI 味分超过阈值时，自动对
# 问题句做一轮「人味重写」（情节不动只改表达），复检分下降才接受，否则保留原稿。
# 开关在 质量规则.json 的 "deai" 键（enabled/threshold），例：
#   "deai": {"enabled": true, "threshold": 60}
# 无该键或 enabled 为 false = 完全不启用（零行为变更）。
# 也可在 REPL 对已存章节手动发起：去AI <文件路径>（不设阈值，y/n 确认后存回）。

# ---- Agent 运行时（可选；不设则默认放 <NOVEL_DIR>/.agent/ 下）----
# NOVEL_RUNS_DIR=
# NOVEL_CHROMA_DIR=

# ---- 编排（可选）----
# 单章目标字数（0.8）：writer 写作 / polisher 扩写共用口径，进 run record 的 config。
# 不设默认 1500。注意 glm-5.2 是推理模型，max_tokens=4096 含内部推理预算，调大时留意截断。
# NOVEL_TARGET_WORDS=1500
#
# ---- 吞吐（2.1 流式 / 2.2 批量连写）----
# 流式输出（2.1）：writer/polisher 专属（审稿/摘要/路由仍非流式），边生成边打印，
# 思考块不进屏幕。默认 1 = 开；0 = 关（回到非流式现状，网关流式不兼容时兜底）。
# NOVEL_STREAM=1
#
# 批量连写单命令最大章数（2.2）：跨度超限直接报错，token 护栏。默认 10。
# NOVEL_BATCH_MAX=10
#
# 每章规划文件即章纲（2.2）：相对 novel_dir 的 markdown 表格路径。
# 表格格式（首列章号，标题列可叫「标题」或「暂定标题」，其后各列全进本章规划）：
#   | 章 | 标题 | 核心事件 | 天气 | 矛盾种子 |
#   | --- | --- | --- | --- | --- |
#   | 5 | 风起 | 主角遇袭 | 雨 | 黑衣人 |
# 用法：写第5-10章（章纲供标题与规划）/ 写第5-10章：模板（模板+序数后缀，规划照注入）
#       / 写第5章（单章也从章纲取标题与规划）/ 尾缀 --auto 免章间确认。
# --auto 为 fail-closed：门禁不过或写作失败自动停批（无人可交时宁停不冒错）。
# 留空 = 禁用章纲（批量必须带标题模板）。默认 每章.md；文件不存在同禁用（静默）。
# NOVEL_CHAPTER_PLAN=每章.md

# ---- 仓库根（可选；仅用于找 .env，不设则用当前工作目录）----
# STORYFORGE_ROOT=/usr/local/workspace/github/StoryForgeAI
